# FlowSpace backend — copy to .env for local dev. Do not commit real secrets.

# MongoDB
MONGO_URL=mongodb://localhost:27017
DB_NAME=flowspace

# Admin panel (/admin/login)
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=hello@flowspace.solutions

# CORS (comma-separated). Must be explicit origins when using member cookies
# (browsers reject Access-Control-Allow-Origin: * with credentials).
CORS_ORIGINS=http://localhost:3000,https://flowspace.solutions,https://www.flowspace.solutions

# Member sessions (JWT). Required in production.
JWT_SECRET=change-me-to-a-long-random-string
# Optional cookie overrides. Defaults: Lax + not Secure on localhost, None + Secure otherwise.
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax

# Anthropic — AI design-plan draft
ANTHROPIC_API_KEY=sk-ant-...

# Replicate — FLUX Kontext (image-to-image) + FLUX 1.1 Pro fallback
REPLICATE_API_TOKEN=r8_...

# Resend — PDF Blueprint email
# 1. Create an API key at https://resend.com/api-keys
# 2. Add and verify the sending domain (flowspace.solutions) at https://resend.com/domains
#    DNS records must be in place (SPF, DKIM, optionally DMARC) before production send.
# 3. FROM address defaults to blueprints@flowspace.solutions once the domain is verified.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=FlowSpace <blueprints@flowspace.solutions>

# Stripe — Plus / Premium checkout + webhook
STRIPE_API_KEY=sk_test_...
# Signing secret from Stripe Dashboard → Webhooks → your endpoint
# Endpoint URL must be: https://<your-railway-backend>/api/webhook/stripe
# Event: checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_...
